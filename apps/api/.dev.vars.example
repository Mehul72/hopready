# Settings for local runs: `pnpm --filter @hopready/api dev` (Node) and `npx wrangler dev` (Workers).
# Copy this file to .dev.vars, which git ignores, and fill in what you have. Never commit .dev.vars.
# A blank value means "not set". A missing provider key only makes that provider unavailable.

# live (real providers through this server) or demo (labelled fixtures, no provider calls). Default: live.
HOPREADY_MODE=
# Transport for NSW Open Data API key, for public transport, stop search and car parks.
TFNSW_API_KEY=
# Apple Developer Team ID (10 characters). Drive times and address search need all three Apple settings.
APPLE_MAPS_TEAM_ID=
# Key ID of the Apple Maps private key (10 characters).
APPLE_MAPS_KEY_ID=
# Contents of the Apple Maps .p8 key, in double quotes; one line with \n between the lines also works.
APPLE_MAPS_PRIVATE_KEY=
# debug, info, warn or error. Default: info.
LOG_LEVEL=
# Most requests to TfNSW per UTC day before this server stops calling TfNSW. Default: 50000.
TFNSW_DAILY_CALL_BUDGET=
# Most requests to the Apple Maps Server API per UTC day before this server stops calling Apple. Default: 20000.
APPLE_MAPS_DAILY_CALL_BUDGET=
# Longest a trip plan may take before the API answers 504, in milliseconds (1000 to 60000). Default: 12000,
# below the app's 15 s request timeout.
PLAN_DEADLINE_MS=
# Node server only: the port to listen on. Default: 8787.
PORT=
# Node server only: the address to listen on. Default: 127.0.0.1. Use 0.0.0.0 to reach it from a phone.
HOST=

{
  "name": "hopready",
  "private": true,
  "description": "Door-to-door trip planning for Greater Sydney: drive, park, walk and public transport in one plan.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "api:dev": "pnpm --filter @hopready/api dev",
    "mobile:start": "pnpm --filter @hopready/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
